# ── Assad Motors chatbot + panel — PRODUCTION environment ──
# Copy to .env on the server and fill in real values:  cp .env.production.example .env
# Variable names match app/inventory_system/config.py. NEVER commit the real .env.

# ── deployment mode ──
# production = refuse to start if insecure (admin key unset / CORS '*' / rate limit <=0).
# Use "development" ONLY for the first HTTP/IP smoke test, then switch to production.
CHAT_ENV=production

# ── security (REQUIRED in production) ──
# Admin key gate for /admin/* — REQUIRED (app won't start in production without it).
CHAT_ADMIN_API_KEYS=CHANGE-ME-long-random-admin-key
# Optional but recommended: keys required on POST /chat (nginx is the public gate too).
CHAT_API_KEYS=CHANGE-ME-long-random-chat-key
# CORS allow-list — REQUIRED explicit in production (no '*'). Your site origin(s).
# Phase 1 IP test: set CHAT_ENV=development instead (wildcard allowed there).
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── rate limiting (must be > 0 in production) ──
CHAT_RATE_LIMIT=120
CHAT_RATE_WINDOW=60

# ── Supabase media storage (REQUIRED for photos/videos) ──
# Copy these from your existing local .env (or the Supabase dashboard → Project Settings → API).
# Without them the app runs but media falls back to a fake in-memory store.
# NOTE: the app reads SUPABASE_KEY (set it to your service-role key value). The
# SERVICE_ROLE line is kept for reference / other tooling only.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-key-value
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-value
CHAT_MEDIA_BUCKET=car-photos

# ── container paths (docker-compose already sets these; here for reference) ──
# The inventory workbook lives in the persistent /data volume, so a code redeploy
# NEVER overwrites live inventory. Do not point this at the image-baked copy.
CHAT_XLSX=/data/IVR_Sheet.xlsx
CHAT_DATA_DIR=/data

# ── behaviour ──
CHAT_LOG_PII_MASKING=true
CHAT_TOP_N=50

# ── Developer Dashboard (read-only monitoring at /developer) ──
# Env-REQUIRED login: the developer account is created on startup ONLY when BOTH
# of these are set. Leave them unset to disable developer login entirely
# (fail-closed — the dashboard then has no way in). Use a long, unique password.
DEV_DASHBOARD_USER=developer
DEV_DASHBOARD_PASSWORD=CHANGE-ME-long-random-developer-password
# Optional tuning:
#   DEV_SLOW_MS=1500                # chat turns at/above this count as "slow"
#   DEV_DASHBOARD_TZ_OFFSET_MIN=330 # local day boundary for "today" (330 = IST)
#   APP_VERSION / GIT_COMMIT        # shown on the dashboard (else auto-detected)

# ── nginx host ports (rarely changed) ──
HTTP_PORT=80
HTTPS_PORT=443
