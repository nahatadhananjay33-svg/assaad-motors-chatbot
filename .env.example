# ── Vasant Oasis chatbot backend — environment ──
# Copy to .env and fill in real values:  cp .env.example .env
# (Never commit .env. The variable names below match inventory_system/config.py.)

# ── API authentication (REQUIRED in production) ──
# Comma-separated keys accepted on POST /chat. Empty = open (dev only).
CHAT_API_KEYS=replace-with-a-long-random-key,another-key-for-a-second-client
# Comma-separated keys accepted on /admin/* (inventory refresh). Keep secret.
CHAT_ADMIN_API_KEYS=replace-with-a-separate-admin-key

# ── CORS ──  (config var: CHAT_CORS_ORIGINS) — origins allowed to call /chat
# Use your website origin(s); avoid "*" once a real frontend exists.
CHAT_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── DATA PATHS ──  inside the container; bind-mounted to ./data on the host
CHAT_DATA_DIR=/data
#   -> data/leads.db, data/analytics.db, data/unknown_queries.db
CHAT_XLSX=/app/IVR_Sheet.xlsx

# ── PORTS ──
CHAT_HOST=0.0.0.0          # app bind host (internal)
CHAT_API_PORT=8000         # app port (internal; nginx proxies to it)
HTTP_PORT=80               # nginx host port (HTTP -> redirects to HTTPS)
HTTPS_PORT=443             # nginx host port (HTTPS)

# ── rate limiting (app-level, per API key / IP) ──
CHAT_RATE_LIMIT=120        # max requests per window (<=0 disables)
CHAT_RATE_WINDOW=60        # window in seconds

# ── privacy / behaviour ──
CHAT_LOG_PII_MASKING=true  # mask phone numbers & names in logs
CHAT_TOP_N=5               # max vehicles returned per answer

# ── nginx TLS (used by the deployment, not the app) ──
DOMAIN=yourdomain.com
LETSENCRYPT_EMAIL=ops@yourdomain.com
